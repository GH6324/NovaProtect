#include <windows.h>
#include "version.rcinc"

1 ICON "../ui/Assets/NovaProtect.ico"

1 VERSIONINFO
 FILEVERSION NOVAPROTECT_FILE_VERSION
 PRODUCTVERSION NOVAPROTECT_PRODUCT_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "NovaProtect"
      VALUE "FileDescription", "NovaProtect Managed EXE Host"
      VALUE "FileVersion", NOVAPROTECT_FILE_VERSION_STR
      VALUE "InternalName", "NovaProtect.ManagedHost.exe"
      VALUE "OriginalFilename", "NovaProtect.ManagedHost.exe"
      VALUE "ProductName", "NovaProtect"
      VALUE "ProductVersion", NOVAPROTECT_PRODUCT_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
