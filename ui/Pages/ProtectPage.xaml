<Page
    x:Class="NovaProtect.UI.Pages.ProtectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="保护项目" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="选择应用、调整保护策略，然后在后台生成受保护版本。"
                                   Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="10,5" CornerRadius="8"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ArchitectureBadge" Text="等待选择文件" FontSize="12" />
                    </Border>
                </Grid>

                <CommandBar DefaultLabelPosition="Right" IsOpen="False">
                    <AppBarButton Icon="OpenFile" Label="导入项目" Click="LoadProject_Click" />
                    <AppBarButton Icon="Save" Label="保存项目" Click="SaveProject_Click" />
                    <AppBarButton Icon="Download" Label="导出项目" Click="ExportProject_Click" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Icon="Document" Label="导出当前构建计划" Click="ExportBuildPlan_Click" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <Border Style="{StaticResource CardStyle}" AllowDrop="True"
                        DragOver="FileCard_DragOver" Drop="FileCard_Drop">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="目标文件" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="支持 C/C++、C#/VB .NET、Rust、Golang 生成的 x86/x64 EXE；也可拖放文件。"
                                           Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource RoundedButtonStyle}"
                                    Click="BrowseInput_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="选择文件" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入文件" VerticalAlignment="Center" />
                            <TextBox x:Name="InputPathBox" Grid.Column="1" Style="{StaticResource RoundedTextBoxStyle}"
                                     PlaceholderText="选择需要保护的应用" TextChanged="InputPathBox_TextChanged" />
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Content="浏览…"
                                    Click="BrowseInput_Click" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出文件" VerticalAlignment="Center" />
                            <TextBox x:Name="OutputPathBox" Grid.Column="1" Style="{StaticResource RoundedTextBoxStyle}"
                                     PlaceholderText="默认生成 *_protected.exe" />
                            <Button Grid.Column="2" Style="{StaticResource RoundedButtonStyle}" Content="另存为…"
                                    Click="BrowseOutput_Click" />
                        </Grid>

                        <InfoBar x:Name="PeInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel>
                            <TextBlock Text="保护模式" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="模式决定代码处理管线；强度参数仍可单独微调。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <RadioButtons x:Name="ModePicker" SelectedIndex="2" MaxColumns="3" SelectionChanged="ModePicker_SelectionChanged">
                            <RadioButton Content="变异模式" Tag="mutation" />
                            <RadioButton Content="虚拟化模式" Tag="virtualization" />
                            <RadioButton Content="Ultra 模式" Tag="ultra" />
                        </RadioButtons>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="预设" VerticalAlignment="Center" />
                            <ComboBox x:Name="PresetBox" Grid.Column="1" SelectedIndex="2" SelectionChanged="PresetBox_SelectionChanged">
                                <ComboBoxItem Content="兼容" Tag="basic" />
                                <ComboBoxItem Content="均衡" Tag="balanced" />
                                <ComboBoxItem Content="高强度" Tag="high" />
                                <ComboBoxItem Content="Ultra" Tag="ultra" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="预设只调整已实现能力；构建前会显示请求值与实际生效值。"
                                       Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                        <InfoBar x:Name="ModeDescription" IsOpen="True" IsClosable="False"
                                 Severity="Success" Title="Ultra 模式"
                                 Message="同时启用代码变异与虚拟化，适合需要最高保护等级的 x64 程序。" />

                        <Grid ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="变异强度" />
                                    <TextBlock x:Name="MutationValue" Text="2 · 中等" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="MutationSlider" Minimum="0" Maximum="3" StepFrequency="1" Value="2"
                                        ValueChanged="MutationSlider_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <Grid>
                                    <TextBlock Text="VM 复杂度" />
                                    <TextBlock x:Name="VmValue" Text="6 / 10" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="VmSlider" Minimum="0" Maximum="10" StepFrequency="1" Value="6"
                                        ValueChanged="VmSlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="运行时防护" Style="{StaticResource SectionTitleStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="反调试级别" VerticalAlignment="Center" />
                                <ComboBox x:Name="AntiDebugBox" Grid.Column="1" SelectedIndex="2" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="基础" Tag="1" />
                                    <ComboBoxItem Content="增强" Tag="2" />
                                    <ComboBoxItem Content="严格" Tag="3" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="环境检查级别" VerticalAlignment="Center" />
                                <ComboBox x:Name="AntiVmBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="基础" Tag="1" />
                                    <ComboBoxItem Content="增强" Tag="2" />
                                </ComboBox>
                            </Grid>
                            <ToggleSwitch x:Name="MemoryProtectionSwitch" Header="内存完整性保护" />
                            <ToggleSwitch x:Name="ImportProtectionSwitch" Header="导入表保护" />
                            <ToggleSwitch x:Name="ResourceProtectionSwitch" Header="资源区段保护" />
                            <TextBlock Text="资源区段加密时会保留程序图标，加密后资源管理器中显示的图标与原文件一致。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="输出处理" Style="{StaticResource SectionTitleStyle}" />
                            <ToggleSwitch x:Name="PackSectionsSwitch" Header="区段压缩" IsOn="True" />
                            <ToggleSwitch x:Name="EncryptSectionsSwitch" Header="区段加密" IsOn="True" />
                            <ToggleSwitch x:Name="StripDebugSwitch" Header="移除调试目录" IsOn="True" />
                            <ToggleSwitch x:Name="StripRelocationsSwitch" Header="裁剪重定位并关闭 ASLR" />
                            <ToggleSwitch x:Name="StripExportsSwitch" Header="裁剪导出目录" />
                            <TextBlock Text="重定位/导出裁剪仅用于原生 EXE；.NET EXE 采用 CLR 安全封装并跳过破坏 CLR 契约的选项。导入虚拟化使用运行时 IAT 重建。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="许可、标识与虚拟文件" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="这些内容会随受保护文件写入元数据或虚拟文件容器。"
                                           Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource RoundedButtonStyle}"
                                    Click="AddVirtualFiles_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="添加虚拟文件" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WatermarkBox" Header="水印" PlaceholderText="可选的产品或构建标识"
                                     Style="{StaticResource RoundedTextBoxStyle}" />
                            <PasswordBox x:Name="LicenseKeyBox" Grid.Column="1" Header="许可密钥"
                                         PlaceholderText="可选" Style="{StaticResource RoundedPasswordBoxStyle}" />
                            <TextBox x:Name="ActivationBindingBox" Grid.Column="2" Header="激活/硬件绑定"
                                     PlaceholderText="16 位机器 ID 或 auto" Style="{StaticResource RoundedTextBoxStyle}" />
                        </Grid>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="能力边界"
                    Message="许可和激活绑定由 x64 保护运行时执行。可在检查工具中读取本机激活 ID；auto 绑定构建机。内部核心不支持直接命令调用。" />
                        <TextBlock x:Name="VirtualFilesEmptyText" Text="尚未添加虚拟文件"
                                   Style="{StaticResource SubtleTextStyle}" />
                        <ListView x:Name="VirtualFilesList" MaxHeight="130" SelectionMode="Multiple" />
                        <Button Content="移除选中项" HorizontalAlignment="Left" Style="{StaticResource RoundedButtonStyle}"
                                Click="RemoveVirtualFiles_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="函数 / 区域对象编辑器" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="对象只来自目标文件中的 NovaProtect SDK BEGIN/END marker；不提供任意函数扫描或虚构选择。"
                                           Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Content="重新扫描 marker"
                                    Style="{StaticResource RoundedButtonStyle}" Click="RescanMarkers_Click" />
                        </Grid>
                        <InfoBar x:Name="MarkerInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="等待目标" Message="选择 PE 后读取 SDK marker。" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="MarkerList" SelectionMode="Single" DisplayMemberPath="Summary"
                                      SelectionChanged="MarkerList_SelectionChanged" MinHeight="150" MaxHeight="260" />
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBox x:Name="MarkerNameBox" Header="显示名称" IsEnabled="False"
                                         TextChanged="MarkerEditor_Changed" Style="{StaticResource RoundedTextBoxStyle}" />
                                <ComboBox x:Name="MarkerModeBox" Header="对象模式" SelectedIndex="0" IsEnabled="False"
                                          SelectionChanged="MarkerEditor_Changed">
                                    <ComboBoxItem Content="继承全局模式" Tag="inherit" />
                                    <ComboBoxItem Content="跳过此 marker 区域" Tag="skip" />
                                    <ComboBoxItem Content="虚拟化" Tag="virtualization" />
                                    <ComboBoxItem Content="Ultra（VM + 前置变异）" Tag="ultra" />
                                </ComboBox>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox x:Name="MarkerVmBox" Header="VM 复杂度" Minimum="0" Maximum="10" Value="6"
                                               IsEnabled="False" ValueChanged="MarkerEditor_NumberChanged" />
                                    <NumberBox x:Name="MarkerMutationBox" Grid.Column="1" Header="变异强度" Minimum="0" Maximum="3" Value="2"
                                               IsEnabled="False" ValueChanged="MarkerEditor_NumberChanged" />
                                </Grid>
                                <ToggleSwitch x:Name="MarkerActivationSwitch" Header="此区域要求启用全局激活绑定" IsEnabled="False"
                                              Toggled="MarkerEditor_Toggled" />
                                <TextBlock x:Name="MarkerRangeText" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="当前目标能力" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="当前文件的精确执行路径和冲突；状态来自实际核心能力与 PE 类型。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ListView x:Name="CapabilityMatrixList" IsItemClickEnabled="False" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding State}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="完整架构能力矩阵" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="横向对照 x86、x64、ARM64 与 .NET；原生 EXE/DLL 的裁剪差异在说明列中明确列出。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                            <StackPanel MinWidth="1040">
                                <Grid ColumnSpacing="10" Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="能力" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="x86 原生" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="x64 原生" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="ARM64" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text=".NET" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="5" Text="事实与边界" FontWeight="SemiBold" />
                                </Grid>
                                <ItemsControl x:Name="ArchitectureMatrixList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="10" Padding="4,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Capability}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding X86}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding X64}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding Arm64}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="4" Text="{Binding DotNet}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="5" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="RunStatusText" Text="准备就绪" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Value="0" Height="6" />
                            <TextBlock x:Name="ConfigSummaryText" Text="请求配置将在开始前解析。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed"
                                    Style="{StaticResource RoundedButtonStyle}" Click="CancelButton_Click" />
                            <Button x:Name="StartButton" Style="{StaticResource AccentActionButtonStyle}"
                                    Click="StartButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                    <TextBlock Text="开始保护" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="实时日志" Style="{StaticResource SectionTitleStyle}" />
                            <Button Content="清空" HorizontalAlignment="Right" Style="{StaticResource RoundedButtonStyle}"
                                    Click="ClearLog_Click" />
                        </Grid>
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" MinHeight="190"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 Style="{StaticResource RoundedTextBoxStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

