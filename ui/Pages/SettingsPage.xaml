<Page
    x:Class="NovaProtect.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="900">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观设置立即生效；在线更新从官网读取已发布的客户端版本。" Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="应用主题" />
                            <TextBlock Text="默认跟随 Windows 系统设置。" Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="default" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于 NovaProtect" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Image Source="../Assets/NovaProtect.png" Width="52" Height="52" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProductVersionText" FontWeight="SemiBold" />
                            <TextBlock Text="WinUI 3 客户端" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="用于保护您拥有合法授权的软件。请在发布前对目标程序执行完整兼容性和安全性测试。"
                               Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="输入：C/C++ · C#/VB .NET · Rust · Golang EXE    核心：C++17 / Windows PE" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    <TextBlock Text="客户端不需要账户登录；官网仅提供安装包下载与版本发布。"
                               Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="在线更新" Style="{StaticResource SectionTitleStyle}" />
                    <InfoBar x:Name="UpdateStatusBar" Title="更新状态" Message="尚未检查更新。" IsOpen="True" IsClosable="False" Severity="Informational" />
                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Style="{StaticResource AccentActionButtonStyle}" AutomationProperties.Name="检查客户端更新">检查更新</Button>
                        <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate_Click" Visibility="Collapsed" AutomationProperties.Name="下载并校验客户端更新">下载更新</Button>
                        <Button x:Name="OpenUpdateButton" Click="OpenUpdate_Click" Visibility="Collapsed" AutomationProperties.Name="运行已校验的安装包">运行安装包</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
