<Page
    x:Class="NovaProtect.UI.Pages.InspectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="1000">
            <StackPanel Spacing="4">
                <TextBlock Text="检查工具" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="读取 PE 信息、嵌入水印和虚拟文件清单，不修改目标文件。"
                           Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" PlaceholderText="选择要检查的文件" Style="{StaticResource RoundedTextBoxStyle}" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource RoundedButtonStyle}" Click="Browse_Click" />
                    </Grid>
                    <CommandBar DefaultLabelPosition="Right" IsOpen="True">
                        <AppBarButton Label="PE 信息" Icon="Document" Click="PeInfo_Click" />
                        <AppBarButton Label="读取水印" Icon="Tag" Click="Watermark_Click" />
                        <AppBarButton Label="虚拟文件" Icon="Folder" Click="VirtualFiles_Click" />
                        <AppBarButton Label="本机激活 ID" Icon="Permissions" Click="MachineId_Click" />
                    </CommandBar>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="检查结果" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             MinHeight="350" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource RoundedTextBoxStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

